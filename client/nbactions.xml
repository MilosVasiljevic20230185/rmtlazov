<?xml version="1.0" encoding="UTF-8"?>
<!--
    NetBeans: "Run" nad client modulom pokrece JavaFX klijent.

    VAZNO: glavna klasa je Launcher, a NE MainApp. Kada je glavna klasa naslednik
    javafx.application.Application, JVM zahteva JavaFX module na module-path-u i
    puca porukom "JavaFX runtime components are missing". Launcher zaobilazi tu
    proveru, pa klijent radi sa JavaFX bibliotekama na obicnom classpath-u.
-->
<actions>
    <action>
        <actionName>run</actionName>
        <packagings>
            <packaging>jar</packaging>
        </packagings>
        <goals>
            <goal>process-classes</goal>
            <goal>org.codehaus.mojo:exec-maven-plugin:3.5.0:exec</goal>
        </goals>
        <properties>
            <exec.executable>java</exec.executable>
            <exec.args>-classpath %classpath com.muvrinovci.lazes.client.Launcher</exec.args>
            <exec.workingdir>${project.basedir}</exec.workingdir>
        </properties>
    </action>

    <action>
        <actionName>debug</actionName>
        <packagings>
            <packaging>jar</packaging>
        </packagings>
        <goals>
            <goal>process-classes</goal>
            <goal>org.codehaus.mojo:exec-maven-plugin:3.5.0:exec</goal>
        </goals>
        <properties>
            <exec.executable>java</exec.executable>
            <exec.args>-agentlib:jdwp=transport=dt_socket,server=n,address=${jpda.address} -classpath %classpath com.muvrinovci.lazes.client.Launcher</exec.args>
            <exec.workingdir>${project.basedir}</exec.workingdir>
            <jpda.listen>true</jpda.listen>
        </properties>
    </action>
</actions>
